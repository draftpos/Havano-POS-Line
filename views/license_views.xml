<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_pos_license_form" model="ir.ui.view">
            <field name="name">pos.license.form</field>
            <field name="model">pos.license</field>
            <field name="arch" type="xml">
                <form string="POS License">
                    <header>
                        <button name="action_generate_license" string="Generate License" type="object" class="oe_highlight"/>
                        <field name="status" widget="statusbar" statusbar_visible="active,expiring,expired,lifetime"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Customer Name..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="machine_id"/>
                                <field name="duration_days"/>
                            </group>
                            <group>
                                <field name="license_key" widget="CopyClipboardChar" readonly="1" force_save="1"/>
                                <field name="creation_date" readonly="1" force_save="1"/>
                                <field name="expiry_date" readonly="1" force_save="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_pos_license_list" model="ir.ui.view">
            <field name="name">pos.license.list</field>
            <field name="model">pos.license</field>
            <field name="arch" type="xml">
                <list string="POS Licenses" decoration-success="status in ('active', 'lifetime')" decoration-warning="status == 'expiring'" decoration-danger="status == 'expired'">
                    <field name="name"/>
                    <field name="machine_id"/>
                    <field name="duration_days"/>
                    <field name="license_key"/>
                    <field name="expiry_date"/>
                    <field name="status" widget="badge" decoration-success="status in ('active', 'lifetime')" decoration-warning="status == 'expiring'" decoration-danger="status == 'expired'"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_pos_license_search" model="ir.ui.view">
            <field name="name">pos.license.search</field>
            <field name="model">pos.license</field>
            <field name="arch" type="xml">
                <search string="Search POS Licenses">
                    <field name="name"/>
                    <field name="machine_id"/>
                    <field name="license_key"/>
                    <filter string="Active" name="active" domain="[('status', 'in', ['active', 'lifetime'])]"/>
                    <filter string="Expiring Soon" name="expiring" domain="[('status', '=', 'expiring')]"/>
                    <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                    <group>
                        <filter string="Status" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_pos_license_kanban" model="ir.ui.view">
            <field name="name">pos.license.kanban</field>
            <field name="model">pos.license</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="machine_id"/>
                    <field name="status"/>
                    <field name="expiry_date"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="mt4">
                                        <strong>Machine ID:</strong> <field name="machine_id"/>
                                    </div>
                                    <div class="mt4" t-if="record.expiry_date.value">
                                        <strong>Expiry:</strong> <field name="expiry_date"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_pos_license_graph" model="ir.ui.view">
            <field name="name">pos.license.graph</field>
            <field name="model">pos.license</field>
            <field name="arch" type="xml">
                <graph string="Licenses by Status" type="bar">
                    <field name="status"/>
                </graph>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_pos_license_pivot" model="ir.ui.view">
            <field name="name">pos.license.pivot</field>
            <field name="model">pos.license</field>
            <field name="arch" type="xml">
                <pivot string="License Analysis">
                    <field name="status" type="row"/>
                    <field name="duration_days" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- Action: All Licenses -->
        <record id="action_pos_license" model="ir.actions.act_window">
            <field name="name">POS Licenses</field>
            <field name="res_model">pos.license</field>
            <field name="view_mode">list,kanban,graph,pivot,form</field>
            <field name="context">{'search_default_group_by_status': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first POS License!
                </p>
                <p>
                    Manage and generate securely signed licenses for Desktop POS.
                </p>
            </field>
        </record>

        <!-- Action: Generate / Create New License directly -->
        <record id="action_pos_license_create" model="ir.actions.act_window">
            <field name="name">Generate New License</field>
            <field name="res_model">pos.license</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

        <!-- Inherit General Settings Form View: Embed as POS Licenses Tab -->
        <record id="res_config_settings_view_form_pos_license" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.pos.license</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app logo="/pos_license_management/static/description/icon.png" data-string="POS Licenses" string="POS Licenses" name="pos_license_management">
                        <block title="POS License Management" name="pos_license_management_block">
                            <setting id="pos_license_manage_setting" string="POS Licenses" help="View and monitor all active, expiring, and expired POS licenses.">
                                <div class="mt16">
                                    <button name="%(action_pos_license)d" type="action" string="Manage Licenses" icon="fa-arrow-right" class="btn-link"/>
                                </div>
                            </setting>
                            <setting id="pos_license_create_setting" string="Generate License" help="Create and issue a new secure POS license key.">
                                <div class="mt16">
                                    <button name="%(action_pos_license_create)d" type="action" string="Generate New License" icon="fa-arrow-right" class="btn-link"/>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
